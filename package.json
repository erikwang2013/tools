{
  "name": "postwoman",
  "version": "1.11.0",
  "description": "A free, fast and beautiful API request builder",
  "author": "liyasthomas",
  "private": true,
  "engines": {
    "node": ">=16 <20"
  },
  "overrides": {
    "@babel/compat-data": "7.9.0"
  },
  "scripts": {
    "predev": "node build.js --dev",
    "dev": "nuxt",
    "prebuild": "node build.js",
    "build": "nuxt build",
    "start": "nuxt start",
    "pregenerate": "node build.js",
    "generate": "nuxt generate",
    "agent": "node agent/index.js",
    "test:unit": "node --test test",
    "test:agent": "npm --prefix agent test",
    "bench:agent": "node agent/bench/local-latency.js",
    "test:perf": "npm --prefix agent run test:perf",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "dev:e2e": "server-test dev :3000 e2e:open",
    "pretty-quick": "pretty-quick --staged --pattern \"**/*.*(html|js|json|vue)\"",
    "test": "start-server-and-test start http-get://localhost:3000 e2e"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run pretty-quick"
    }
  },
  "prettier": {
    "trailingComma": "es5",
    "semi": false,
    "singleQuote": false,
    "printWidth": 100
  },
  "dependencies": {
    "@nuxtjs/axios": "^5.9.5",
    "@nuxtjs/pwa": "^3.0.0-beta.20",
    "@nuxtjs/robots": "^2.4.2",
    "@nuxtjs/sitemap": "^2.0.1",
    "@nuxtjs/toast": "^3.3.0",
    "@stomp/stompjs": "^6.1.2",
    "@xmpp/client": "^0.13.6",
    "ace-builds": "^1.4.8",
    "graphql": "^14.6.0",
    "graphql-language-service-interface": "^2.3.3",
    "hls.js": "^1.7.3",
    "hooks": "^0.3.2",
    "nuxt": "^2.12.0",
    "nuxt-i18n": "^6.6.1",
    "paho-mqtt": "^1.1.0",
    "sip.js": "^0.21.2",
    "socket.io-client": "^2.3.0",
    "v-tooltip": "^2.0.3",
    "vue-virtual-scroll-list": "^1.4.6",
    "vuejs-auto-complete": "^0.9.0",
    "vuex-persist": "^2.2.0",
    "yargs-parser": "^18.1.1"
  },
  "devDependencies": {
    "cypress": "^4.2.0",
    "husky": "^4.2.5",
    "lint-staged": "^10.0.8",
    "prettier": "^1.19.1",
    "pretty-quick": "^2.0.1",
    "sass": "^1.32.13",
    "sass-loader": "^8.0.2",
    "start-server-and-test": "^1.10.11"
  }
}
